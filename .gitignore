# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committed, or nobody knows EDITOR_SECRET exists.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only game images.
#
# The colour game can load your own character images from here. Nothing in this
# folder is committed or deployed, which is the point: you can drop in whatever
# reference art you like for local play without it ending up in the repo or on
# quizmo.auridev.com. See src/lib/games/local-images.ts.
/public/tint-local/

# Raw generated brand candidates: every rejected mark, banner and plate.
#
# The chosen assets and the READMEs explaining why they won are committed; these
# are the working dumps behind them, about 9MB. Repo weight is permanent and
# every clone pays it, so the reasoning is kept and the raw output is not.
# Regenerate with `node scripts/generate-brand-assets.mjs`.
brand-assets/**/candidates/
brand-assets/candidates/
