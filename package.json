{
  "name": "lys-kvizai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "backfill-dates": "node scripts/backfill-createdat.mjs",
    "build": "next build",
    "clean": "rm -rf .next tsconfig.tsbuildinfo",
    "dev": "next dev --hostname 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 16",
    "lint:fix": "eslint --fix",
    "news-quiz": "tsx scripts/news-quiz-generator.ts",
    "qa": "bash scripts/qa-monitor.sh",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "agentation": "^2.2.1",
    "lucide-react": "^0.574.0",
    "next": "^16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.12.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
