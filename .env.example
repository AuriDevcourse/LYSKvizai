# Copy to .env.local and fill in. .env* is gitignored.

# --- Editor auth (REQUIRED in production) -----------------------------------
# Shared password for creating, editing and deleting quizzes, and for uploading
# media. Without it these endpoints are open to anyone who finds the URL.
#
# Behaviour when unset:
#   development  → editor stays open, no password needed
#   production   → every editor write is refused with 503 (fail closed)
#
# Generate one:  openssl rand -base64 24
#
# Use the generated value, not a memorable one. Wrong passwords are throttled
# (10 failures per IP per 5 minutes), but throttling is a backstop — the thing
# that actually makes this safe is 24 bytes of entropy.
EDITOR_SECRET=

# --- Feedback email ---------------------------------------------------------
# Resend API key for the in-app feedback button. Without it, feedback returns 500.
RESEND_API_KEY=
# Where feedback lands. Defaults to baciauskas.aurimas@gmail.com.
FEEDBACK_TO_EMAIL=

# --- Multiplayer rewrites (optional) ----------------------------------------
# Base URL of a separate multiplayer server. Unset = rewrites disabled and the
# app serves /api/rooms itself, which is the normal single-server setup.
MP_SERVER_URL=

# --- News quiz generator (npm run news-quiz, optional) ----------------------
# Claude API key for scripts/news-quiz-generator.ts. Not needed by the app
# itself — only by the CLI script that generates daily news quizzes.
ANTHROPIC_API_KEY=
